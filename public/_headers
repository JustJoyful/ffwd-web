# Cloudflare Pages headers. tests/build/shell.test.js parses this file: keep every comment on its own non-indented
# line, and keep the "/*" block equal to isolation-headers.js.
#
# Cross-origin isolation (COOP same-origin + COEP credentialless) is what gives the page SharedArrayBuffer for the
# multithreaded ffmpeg.wasm and the multithreaded model runtime. It is sent on every page, not only /app*, because a
# client-side navigation from another page into /app would keep the old document's (non-isolated) headers.
# credentialless, not require-corp: a cross-origin no-cors load is sent without cookies instead of needing a CORP
# header, so a cross-origin ranged fetch of the model works (verified, see below).
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Fingerprinted build output (content hash in the file name): cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=86400

# The ffmpeg.wasm core (core-mt 0.12.10) is served from OUR origin for now, copied into /ffmpeg by
# scripts/copy-core.mjs. Its file names are not fingerprinted, so only one day: never "immutable" here.
# KNOWN LIMIT: ffmpeg-core.wasm is about 31 MB and Cloudflare Pages caps a file at 25 MiB, so this cannot ship from
# Pages as it is. The plan is the R2 asset host below; until it exists the core is a local/dev arrangement.
/ffmpeg/*
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

