{
  "name": "ffwd-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.13.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run tests/unit",
    "test:browser-gguf": "vitest run --project browser-gguf",
    "test:build": "pnpm build && vitest run tests/build",
    "compare": "node scripts/compare-mockup.mjs",
    "copy-core": "node scripts/copy-core.mjs",
    "e2e": "playwright test",
    "check:release": "node scripts/check-release.mjs",
    "size": "size-limit",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@ffmpeg/core-mt": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@fontsource-variable/funnel-display": "5.3.0",
    "@fontsource-variable/funnel-sans": "5.3.0",
    "@react-router/node": "8.5.2",
    "@wllama/wllama": "4.0.0",
    "ajv": "8.17.1",
    "posthog-js": "1.453.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@react-router/dev": "8.5.2",
    "@size-limit/file": "14.3.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "pixelmatch": "8.0.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0",
    "prettier": "3.10.1",
    "size-limit": "14.3.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
