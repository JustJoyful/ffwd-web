{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ffmpeg-agent.dev/protocol/v0.3.0/probe",
  "title": "Normalised probe result (ARCHITECTURE §3.3); same schema in both runtimes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["container", "duration_s", "size_bytes", "bit_rate", "streams"],
  "properties": {
    "container": {"type": "string"},
    "duration_s": {"type": ["number", "null"]},
    "size_bytes": {"type": "integer", "minimum": 0},
    "bit_rate": {"type": ["integer", "null"]},
    "streams": {"type": "array", "items": {"$ref": "#/$defs/stream"}}
  },
  "$defs": {
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "type", "codec"],
      "properties": {
        "index": {"type": "integer"},
        "type": {"enum": ["video", "audio", "subtitle", "data", "attachment", "unknown"]},
        "codec": {"type": ["string", "null"]},
        "width": {"type": ["integer", "null"]},
        "height": {"type": ["integer", "null"]},
        "fps": {"type": ["number", "null"]},
        "pix_fmt": {"type": ["string", "null"]},
        "rotation": {"enum": [0, 90, 180, 270]},
        "sample_rate": {"type": ["integer", "null"]},
        "channels": {"type": ["integer", "null"]},
        "start_time_s": {"type": ["number", "null"]},
        "duration_s": {"type": ["number", "null"]}
      }
    }
  }
}
