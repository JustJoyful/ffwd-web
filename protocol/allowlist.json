{
  "_doc": "FFmpeg allowlist v0.2.0 (RULES §1.2; protocol 0.3.0: `-display_rotation` removed, it does not exist in FFmpeg 5.1.x native or ffmpeg.wasm 5.1.4, so lossless rotation is `-metadata:s:v:0 rotate=<counterclockwise degrees>`, D-024). Option keys are base names; a ':stream-spec' suffix is stripped before lookup. Value kinds: flag (no value), time, number, int, bitrate, codec, filtergraph, map, pix_fmt, muxer, metadata, enum:<a,b,...>. Files are never option values: they appear only as {in:<id>} after -i and {out:<id>} as positionals. Filters that read files (movie, amovie, subtitles, ass, drawtext, lut3d, ...) are deliberately absent.",
  "options": {
    "-ss": "time", "-t": "time", "-to": "time", "-itsoffset": "time",
    "-c": "codec", "-codec": "codec", "-vcodec": "codec", "-acodec": "codec",
    "-b": "bitrate", "-maxrate": "bitrate", "-minrate": "bitrate", "-bufsize": "bitrate",
    "-vf": "filtergraph", "-af": "filtergraph", "-filter": "filtergraph", "-filter_complex": "filtergraph",
    "-map": "map", "-map_metadata": "map", "-map_chapters": "map",
    "-r": "number", "-aspect": "number", "-level": "number",
    "-an": "flag", "-vn": "flag", "-sn": "flag", "-dn": "flag", "-shortest": "flag", "-noautorotate": "flag", "-copyts": "flag",
    "-crf": "int", "-qp": "int", "-q": "int", "-g": "int", "-frames": "int", "-vframes": "int",
    "-ar": "int", "-ac": "int", "-loop": "int", "-start_number": "int", "-threads": "int", "-update": "int",
    "-preset": "enum:ultrafast,superfast,veryfast,faster,fast,medium,slow,realtime,good",
    "-tune": "enum:film,animation,grain,stillimage,fastdecode,zerolatency",
    "-profile": "enum:baseline,main,high,main10",
    "-pix_fmt": "pix_fmt",
    "-f": "muxer",
    "-movflags": "enum:+faststart,faststart",
    "-tag": "enum:hvc1,avc1,hev1",
    "-fps_mode": "enum:cfr,vfr,passthrough",
    "-avoid_negative_ts": "enum:make_zero,auto,make_non_negative",
    "-metadata": "metadata"
  },
  "encoders": [
    "libx264", "libx265", "libvpx", "libvpx-vp9", "mpeg4", "gif", "png", "mjpeg",
    "aac", "libmp3lame", "libopus", "libvorbis", "flac", "pcm_s16le"
  ],
  "filters": [
    "trim", "atrim", "setpts", "asetpts", "scale", "crop", "pad", "transpose", "hflip", "vflip",
    "fps", "concat", "volume", "loudnorm", "dynaudnorm", "adelay", "atempo", "palettegen", "paletteuse",
    "split", "asplit", "format", "aformat", "aresample", "select", "aselect", "setsar", "setdar",
    "null", "anull", "apad"
  ],
  "muxers": ["mp4", "mov", "matroska", "webm", "avi", "mp3", "wav", "adts", "ipod", "ogg", "opus", "flac", "gif", "image2"],
  "pix_fmts": ["yuv420p", "yuv422p", "yuv444p", "yuv420p10le", "nv12", "rgb24", "rgba", "gray", "pal8"]
}
