{"name": "fps=1/2 on a 10 s clip gives 5 frames: interval + count", "inputs": ["h264_25fps_720p"], "spec": {"id": "out1", "kind": "image_sequence", "frames": {"interval_s": 2, "expected_count": 5, "format": "png"}}, "args": ["-i", "{in:h264_25fps_720p}", "-vf", "fps=1/2", "{out:out1}"], "passed": true, "failed_fields": [], "runtimes": ["native"]}
{"name": "a wrong explicit count fails (zero tolerance)", "inputs": ["h264_25fps_720p"], "spec": {"id": "out1", "kind": "image_sequence", "frames": {"interval_s": 2, "expected_count": 6, "format": "png"}}, "args": ["-i", "{in:h264_25fps_720p}", "-vf", "fps=1/2", "{out:out1}"], "passed": false, "failed_fields": ["frames.expected_count"], "runtimes": ["native"]}
{"name": "select-based sampling gives the same 5 frames", "inputs": ["h264_25fps_720p"], "spec": {"id": "out1", "kind": "image_sequence", "frames": {"interval_s": 2, "expected_count": 5, "format": "png"}}, "args": ["-i", "{in:h264_25fps_720p}", "-vf", "select='isnan(prev_selected_t)+gte(t-prev_selected_t,2)'", "-fps_mode", "vfr", "{out:out1}"], "passed": true, "failed_fields": [], "runtimes": ["native"]}
{"name": "one frame per second between 2 s and 7 s: 5 frames", "inputs": ["h264_25fps_720p"], "spec": {"id": "out1", "kind": "image_sequence", "frames": {"interval_s": 1, "expected_count": 5, "format": "png"}}, "args": ["-ss", "2", "-t", "5", "-i", "{in:h264_25fps_720p}", "-vf", "fps=1", "{out:out1}"], "passed": true, "failed_fields": [], "runtimes": ["native"]}
{"name": "jpg requested: the harness names files .jpg, so format is satisfied", "inputs": ["h264_25fps_720p"], "spec": {"id": "out1", "kind": "image_sequence", "frames": {"interval_s": 2, "expected_count": 5, "format": "jpg"}}, "args": ["-i", "{in:h264_25fps_720p}", "-vf", "fps=1/2", "{out:out1}"], "passed": true, "failed_fields": [], "runtimes": ["native"], "note": "format cannot mismatch: the harness chooses the file extension from the spec"}
{"name": "boundary: 4 s clip, interval 3: fps filter drops the last slot (1 frame); interval-only spec accepts it", "inputs": ["h264_aac_1080p"], "spec": {"id": "out1", "kind": "image_sequence", "frames": {"interval_s": 3, "expected_count": null, "format": "png"}}, "args": ["-i", "{in:h264_aac_1080p}", "-vf", "fps=1/3", "{out:out1}"], "passed": true, "failed_fields": [], "runtimes": ["native"], "note": "strict count 2 (t=0,3); last sample is 1 s from the end < 1.5 s, so 1..2 accepted"}
{"name": "boundary: select keeps the last slot (2 frames); interval-only spec accepts it", "inputs": ["h264_aac_1080p"], "spec": {"id": "out1", "kind": "image_sequence", "frames": {"interval_s": 3, "expected_count": null, "format": "png"}}, "args": ["-i", "{in:h264_aac_1080p}", "-vf", "select='isnan(prev_selected_t)+gte(t-prev_selected_t,3)'", "-fps_mode", "vfr", "{out:out1}"], "passed": true, "failed_fields": [], "runtimes": ["native"]}
{"name": "boundary: an explicit expected_count of 2 rejects the fps filter's 1 frame", "inputs": ["h264_aac_1080p"], "spec": {"id": "out1", "kind": "image_sequence", "frames": {"interval_s": 3, "expected_count": 2, "format": "png"}}, "args": ["-i", "{in:h264_aac_1080p}", "-vf", "fps=1/3", "{out:out1}"], "passed": false, "failed_fields": ["frames.expected_count"], "runtimes": ["native"]}
{"name": "far from the boundary the count is exact: interval-only spec rejects 4 frames for a 10 s clip at interval 2", "inputs": ["h264_25fps_720p"], "spec": {"id": "out1", "kind": "image_sequence", "frames": {"interval_s": 2, "expected_count": null, "format": "png"}}, "args": ["-i", "{in:h264_25fps_720p}", "-vf", "fps=1/2.5", "{out:out1}"], "passed": false, "failed_fields": ["frames.count_for_interval"], "runtimes": ["native"], "note": "fps=1/2.5 on 10 s gives 4 frames; strict count 5, last sample 2 s from end >= 1 s, so exactly 5"}
