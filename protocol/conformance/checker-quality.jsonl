{"name": "good 1 Mbps compression under the cap passes the default quality floor", "inputs": ["h264_long"], "spec": {"id": "out1", "kind": "video", "container": "mp4", "size_max_bytes": 3000000}, "args": ["-i", "{in:h264_long}", "-b:v", "1000k", "-c:v", "libx264", "-c:a", "aac", "{out:out1}"], "passed": true, "failed_fields": [], "runtimes": ["native"]}
{"name": "a mushy 8x4 picture scaled back up meets the size cap but fails both floors", "inputs": ["h264_long"], "spec": {"id": "out1", "kind": "video", "container": "mp4", "size_max_bytes": 3000000}, "args": ["-i", "{in:h264_long}", "-vf", "scale=8:4,scale=1280:720", "-c:v", "libx264", "-c:a", "aac", "{out:out1}"], "passed": false, "failed_fields": ["quality.min_ssim", "quality.min_psnr_db"], "runtimes": ["native"], "note": "the cheap way to hit a size cap"}
{"name": "a 64x36 picture (tiny output) fails the quality floor", "inputs": ["h264_long"], "spec": {"id": "out1", "kind": "video", "container": "mp4", "size_max_bytes": 3000000}, "args": ["-i", "{in:h264_long}", "-vf", "scale=64:36", "-c:v", "libx264", "-c:a", "aac", "{out:out1}"], "passed": false, "failed_fields": ["quality.min_ssim", "quality.min_psnr_db"], "runtimes": ["native"]}
{"name": "truncated output meets the size cap but fails the implicit duration check (and the floor: past its end the last frame is compared to the rest)", "inputs": ["h264_long"], "spec": {"id": "out1", "kind": "video", "container": "mp4", "size_max_bytes": 3000000}, "args": ["-i", "{in:h264_long}", "-t", "2", "-crf", "18", "-c:v", "libx264", "-c:a", "aac", "{out:out1}"], "passed": false, "failed_fields": ["implicit.duration_s", "quality.min_psnr_db"], "runtimes": ["native"]}
{"name": "an explicit min_ssim of 0.99 rejects a 1 Mbps encode (ssim 0.98)", "inputs": ["h264_long"], "spec": {"id": "out1", "kind": "video", "container": "mp4", "size_max_bytes": 3000000, "quality": {"min_ssim": 0.99, "min_psnr_db": null}}, "args": ["-i", "{in:h264_long}", "-b:v", "1000k", "-c:v", "libx264", "-c:a", "aac", "{out:out1}"], "passed": false, "failed_fields": ["quality.min_ssim"], "runtimes": ["native"]}
{"name": "a trimmed size-target output is exempt from the default floor (frames are not comparable)", "inputs": ["h264_long"], "spec": {"id": "out1", "kind": "video", "container": "mp4", "size_max_bytes": 3000000, "time": {"start_s": 2, "end_s": 8, "tolerance_s": 0.2}}, "args": ["-ss", "2", "-t", "6", "-i", "{in:h264_long}", "-vf", "scale=64:36", "-c:v", "libx264", "-c:a", "aac", "{out:out1}"], "passed": true, "failed_fields": [], "runtimes": ["native"], "note": "KNOWN GAP: a degenerate picture can pass on trimmed/reframed size tasks; only an explicit `quality` field closes it"}
