{"name": "s07: a 0.1 s H.264 output must FAIL (implicit duration)", "inputs": ["hevc_iphone"], "spec": {"id": "out1", "kind": "video", "container": "mp4", "video": {"codec": "h264", "pix_fmt": "yuv420p"}, "audio": {"codec": "aac"}}, "args": ["-i", "{in:hevc_iphone}", "-t", "0.1", "-c:v", "libx264", "-preset", "ultrafast", "-pix_fmt", "yuv420p", "-c:a", "aac", "{out:out1}"], "passed": false, "failed_fields": ["implicit.duration_s"], "runtimes": ["native"], "note": "the Phase 0 checker passed this; every field in the spec was satisfied by a 0.1 s clip"}
{"name": "s07: a full-length H.264/AAC conversion passes", "inputs": ["hevc_iphone"], "spec": {"id": "out1", "kind": "video", "container": "mp4", "video": {"codec": "h264", "pix_fmt": "yuv420p"}, "audio": {"codec": "aac"}}, "args": ["-i", "{in:hevc_iphone}", "-c:v", "libx264", "-preset", "ultrafast", "-pix_fmt", "yuv420p", "-c:a", "aac", "{out:out1}"], "passed": true, "failed_fields": [], "runtimes": ["native"]}
{"name": "s08-style conversion that silently drops audio fails (implicit audio presence)", "inputs": ["vp9_opus_webm"], "spec": {"id": "out1", "kind": "video", "container": "mp4"}, "args": ["-i", "{in:vp9_opus_webm}", "-an", "-c:v", "libx264", "-preset", "ultrafast", "-pix_fmt", "yuv420p", "{out:out1}"], "passed": false, "failed_fields": ["implicit.audio_present"], "runtimes": ["native"]}
{"name": "explicit audio.present=false permits removing audio", "inputs": ["h264_aac_1080p"], "spec": {"id": "out1", "kind": "video", "container": "mp4", "audio": {"present": false}}, "args": ["-i", "{in:h264_aac_1080p}", "-an", "-c:v", "copy", "{out:out1}"], "passed": true, "failed_fields": [], "runtimes": ["native"]}
{"name": "input without audio stays without audio and passes", "inputs": ["h264_noaudio"], "spec": {"id": "out1", "kind": "video", "container": "mp4"}, "args": ["-i", "{in:h264_noaudio}", "-c", "copy", "{out:out1}"], "passed": true, "failed_fields": [], "runtimes": ["native"]}
{"name": "start_s in the spec lets the duration shrink", "inputs": ["h264_long"], "spec": {"id": "out1", "kind": "video", "container": "mp4", "time": {"start_s": 3, "end_s": null, "tolerance_s": 0.15}}, "args": ["-ss", "3", "-i", "{in:h264_long}", "-c", "copy", "{out:out1}"], "passed": true, "failed_fields": [], "runtimes": ["native"]}
{"name": "speed-up with no time field fails (duration halves)", "inputs": ["h264_long"], "spec": {"id": "out1", "kind": "video", "container": "mp4"}, "args": ["-i", "{in:h264_long}", "-vf", "setpts=0.5*PTS", "-af", "atempo=2", "-c:v", "libx264", "-preset", "ultrafast", "-pix_fmt", "yuv420p", "-c:a", "aac", "{out:out1}"], "passed": false, "failed_fields": ["implicit.duration_s"], "runtimes": ["native"]}
{"name": "speed-up passes when the spec states the new duration", "inputs": ["h264_long"], "spec": {"id": "out1", "kind": "video", "container": "mp4", "time": {"start_s": null, "end_s": 10, "tolerance_s": 0.2}}, "args": ["-i", "{in:h264_long}", "-vf", "setpts=0.5*PTS", "-af", "atempo=2", "-c:v", "libx264", "-preset", "ultrafast", "-pix_fmt", "yuv420p", "-c:a", "aac", "{out:out1}"], "passed": true, "failed_fields": [], "runtimes": ["native"]}
{"name": "merge must cover the sum of the inputs", "inputs": ["clip_a", "clip_b"], "spec": {"id": "out1", "kind": "video", "container": "mp4"}, "args": ["-i", "{in:clip_a}", "-i", "{in:clip_b}", "-filter_complex", "[0:v][0:a][1:v][1:a]concat=n=2:v=1:a=1[v][a]", "-map", "[v]", "-map", "[a]", "-c:v", "libx264", "-preset", "ultrafast", "-pix_fmt", "yuv420p", "-c:a", "aac", "{out:out1}"], "passed": true, "failed_fields": [], "runtimes": ["native"]}
{"name": "merge output of only the first clip fails", "inputs": ["clip_a", "clip_b"], "spec": {"id": "out1", "kind": "video", "container": "mp4"}, "args": ["-i", "{in:clip_a}", "-i", "{in:clip_b}", "-map", "0:v", "-map", "0:a", "-c:v", "libx264", "-preset", "ultrafast", "-pix_fmt", "yuv420p", "-c:a", "aac", "{out:out1}"], "passed": false, "failed_fields": ["implicit.duration_s"], "runtimes": ["native"]}
{"name": "audio-only mp4 labelled kind=video fails (implicit video stream)", "inputs": ["h264_aac_1080p"], "spec": {"id": "out1", "kind": "video", "container": "mp4"}, "args": ["-i", "{in:h264_aac_1080p}", "-vn", "-c:a", "aac", "{out:out1}"], "passed": false, "failed_fields": ["implicit.video_stream"], "runtimes": ["native"]}
{"name": "fixing a baked 500 ms offset shortens the container by the shift and still passes", "inputs": ["av_late_500"], "spec": {"id": "out1", "kind": "video", "container": "mp4", "audio": {"offset_ms": 0}}, "args": ["-i", "{in:av_late_500}", "-itsoffset", "-0.5", "-i", "{in:av_late_500}", "-map", "0:v:0", "-map", "1:a:0", "-c", "copy", "{out:out1}"], "passed": true, "failed_fields": [], "runtimes": ["native"]}
{"name": "an offset spec does not excuse a clip that lost most of its length", "inputs": ["av_late_500"], "spec": {"id": "out1", "kind": "video", "container": "mp4", "audio": {"offset_ms": 0}}, "args": ["-i", "{in:av_late_500}", "-itsoffset", "-0.5", "-i", "{in:av_late_500}", "-map", "0:v:0", "-map", "1:a:0", "-t", "1", "-c", "copy", "{out:out1}"], "passed": false, "failed_fields": ["implicit.duration_s"], "runtimes": ["native"]}
