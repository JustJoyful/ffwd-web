{"name": "trim range", "spec": {"family": ["F1"], "outputs": [{"id": "out1", "kind": "video", "container": "mp4", "time": {"start_s": 12, "end_s": 18, "tolerance_s": 0.15}}]}, "lines": ["Result: a video (MP4)", "Keep from 0:12 to 0:18"]}
{"name": "iphone to mp4", "spec": {"family": ["F3"], "outputs": [{"id": "out1", "kind": "video", "container": "mp4", "video": {"codec": "h264", "pix_fmt": "yuv420p"}, "audio": {"codec": "aac"}}]}, "lines": ["Result: a video (MP4)", "Video codec: H.264", "Pixel format: yuv420p", "Audio codec: AAC"]}
{"name": "vertical under 2 MB, no sound", "spec": {"family": ["F4", "F6", "F9"], "outputs": [{"id": "out1", "kind": "video", "container": "mp4", "video": {"width": 1080, "height": 1920}, "audio": {"present": false}, "size_max_bytes": 2000000}]}, "lines": ["Result: a video (MP4)", "Picture size: 1080 x 1920 pixels", "Sound: removed", "File size: at most 2 MB"]}
{"name": "rotate left lossless", "spec": {"family": ["F5"], "outputs": [{"id": "out1", "kind": "video", "container": "mp4", "video": {"rotation": 270, "width": 1080, "height": 1920}, "lossless": true}]}, "lines": ["Result: a video (MP4)", "Picture size: 1080 x 1920 pixels", "Rotation: picture turned 90 degrees to the left (counterclockwise)", "No re-encoding: the picture quality is untouched"]}
{"name": "frames every 2 s", "spec": {"family": ["F7"], "outputs": [{"id": "frames", "kind": "image_sequence", "frames": {"interval_s": 2, "expected_count": 5, "format": "png"}}]}, "lines": ["Result: a set of images", "One image every 2 seconds (5 images)", "Image format: PNG"]}
{"name": "audio fix", "spec": {"family": ["F11"], "outputs": [{"id": "out1", "kind": "video", "container": "mp4", "audio": {"offset_ms": -500}}]}, "lines": ["Result: a video (MP4)", "Sound starts 500 ms earlier than the picture"]}
{"name": "speed 2x and loudness", "spec": {"family": ["F12", "F10"], "outputs": [{"id": "out1", "kind": "video", "time": {"start_s": null, "end_s": 10, "tolerance_s": 0.2}, "audio": {"loudness_lufs": -16}}]}, "lines": ["Result: a video", "Loudness: about -16 LUFS", "Length: about 10 seconds"]}
{"name": "mp3 from 0:05", "spec": {"family": ["F9", "F1"], "outputs": [{"id": "out1", "kind": "audio", "container": "mp3", "time": {"start_s": 5, "end_s": null, "tolerance_s": 0.2}, "audio": {"codec": "mp3"}}]}, "lines": ["Result: an audio file (MP3)", "Audio codec: MP3", "Start at 0:05 and keep the rest"]}
